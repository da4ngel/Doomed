# Names only — never real values. Copy to .env and fill in.

# --- LLM / VLM providers ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Bedrock uses the standard AWS chain (env, profile, or SSO)
AWS_REGION=us-east-1
AWS_PROFILE=

# --- Model routing (two tiers only, per ADR-001) ---
LLM_MODEL_SYNTHESIS=deepseek/deepseek-chat
LLM_MODEL_CHEAP=
LLM_MODEL_VISION=

# --- Stores ---
# Embedded Qdrant by default; set QDRANT_URL to use the docker-compose service instead.
QDRANT_PATH=data/index/qdrant
QDRANT_URL=

# --- Local-first embeddings (no Voyage key required) ---
EMBED_BACKEND=local
EMBED_MODEL_LOCAL=BAAI/bge-small-en-v1.5
RERANK_MODEL_LOCAL=Xenova/ms-marco-MiniLM-L-6-v2
