# Names only — never real values. Copy to .env and fill in.

# --- LLM / VLM providers ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Bedrock uses the standard AWS chain (env, profile, or SSO)
AWS_REGION=us-east-1
AWS_PROFILE=

# --- Model routing (two tiers only, per ADR-001) ---
LLM_MODEL_SYNTHESIS=deepseek/deepseek-chat
# Must be a model that can SEE. An empty value here overrode the working default and
# sent every figure to the text-only synthesis model.
LLM_MODEL_VISION=qwen/qwen2.5-vl-72b-instruct:free

# --- Stores ---
# Embedded Qdrant by default; set QDRANT_URL to use the docker-compose service instead.
QDRANT_PATH=data/index/qdrant
QDRANT_URL=

# --- Local-first embeddings (no Voyage key required) ---
EMBED_BACKEND=local
EMBED_MODEL_LOCAL=BAAI/bge-small-en-v1.5
RERANK_MODEL_LOCAL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Reasoning safeguards ---
# Standard UI searches request 6 steps; Deep Semantic Search can use this full ceiling.
MAX_STEPS=12
MAX_TOKENS_PER_QUERY=200000
MAX_WALL_MS=90000
