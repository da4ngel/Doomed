# Secrets — never commit
.env
.env.local
.env.*.local

# Corpus is READ-ONLY, 123MB, and supplied by the competition. Never in git.
data/corpus/
data/assets/
data/index/
data/cache/
# Downloaded ONNX embedding weights (~65MB). Reproducible via fastembed on first run,
# and the submission ships the full .git history - a binary blob here bloats it forever.
data/models/
# Chunk-size sweep builds three throwaway indexes plus its own copy of the ONNX weights.
# The numbers live in docs/reports/chunk-sweep.json; the indexes are rebuildable and huge.
data/sweep/

# Local stores
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node / UI
node_modules/

# Models cached by fastembed
.fastembed_cache/

# Misc
*.log
.DS_Store
Thumbs.db
