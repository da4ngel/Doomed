{
  "info": {
    "name": "Ashen Era Archive Assistant - Knowledge Layer",
    "description": "Contract tests for the knowledge layer: health, retrieval, graph and assets.\n\nThe assertions are not smoke tests. Each one pins a property the corpus deliberately attacks - the Emberdeep chart trap, the Greyfell/Ironfell name decoy, the Thrice-Bound Edge/Lantern pair - so a regression shows up as a failed test rather than a plausible wrong answer.\n\nRun: newman run tests/postman/AshenEra.postman_collection.json -e tests/postman/local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "emberdeep_asset", "value": "img_29ea682914218630" },
    { "key": "greyfell_asset", "value": "img_dbcafc216d7109ab" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/health", "host": ["{{base_url}}"], "path": ["v1", "health"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('fast', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
              "const r = pm.response.json();",
              "pm.test('reports a version', () => pm.expect(r.version).to.be.a('string').and.not.empty);"
            ] }
          }]
        },
        {
          "name": "ready - index is populated",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/ready", "host": ["{{base_url}}"], "path": ["v1", "ready"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('status is ready', () => pm.expect(r.status).to.eql('ready'));",
              "pm.test('all six stores populated', () => {",
              "  pm.expect(r.documents, 'documents').to.be.above(200);",
              "  pm.expect(r.chunks, 'chunks').to.be.above(2000);",
              "  pm.expect(r.images_described, 'images').to.eql(70);",
              "  pm.expect(r.entities, 'entities').to.be.above(200);",
              "  pm.expect(r.relations, 'relations').to.be.above(350);",
              "});",
              "pm.test('models are warm', () => pm.expect(r.warm).to.be.true);",
              "pm.collectionVariables.set('index_backend', r.index_backend);"
            ] }
          }]
        }
      ]
    },
    {
      "name": "02 Retrieval",
      "item": [
        {
          "name": "1A trap - Greyfell garrison lives only in an image",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"query\":\"Greyfell Citadel recorded garrison strength\",\"k\":5}" },
            "url": { "raw": "{{base_url}}/v1/search", "host": ["{{base_url}}"], "path": ["v1", "search"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('latency budget', () => pm.expect(r.latency_ms).to.be.below(8000));",
              "pm.test('returns hits', () => pm.expect(r.hits.length).to.be.above(0));",
              "",
              "// 3,695 appears in NO document in the archive - only in the plate.",
              "pm.test('top hit is the Greyfell plate', () => {",
              "  pm.expect(r.hits[0].doc_id).to.include('plate_09_location_greyfell');",
              "});",
              "pm.test('the plate is a tier-1 source', () => pm.expect(r.hits[0].authority_tier).to.eql(1));",
              "pm.test('the answer 3,695 is in the retrieved text', () => {",
              "  pm.expect(r.hits[0].text.replace(/,/g, '')).to.include('3695');",
              "});",
              "",
              "// Ironfell Citadel (1,096) is the planted decoy - it may appear, never first.",
              "pm.test('the Ironfell decoy does not outrank it', () => {",
              "  const ironfell = r.hits.findIndex(h => h.text.toLowerCase().includes('ironfell'));",
              "  if (ironfell !== -1) pm.expect(ironfell).to.be.above(0);",
              "});"
            ] }
          }]
        },
        {
          "name": "confusable pair - Lantern must outrank Edge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"query\":\"Thrice-Bound Lantern attunement cost\",\"k\":5}" },
            "url": { "raw": "{{base_url}}/v1/search", "host": ["{{base_url}}"], "path": ["v1", "search"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "// The names differ by one token; dense similarity pulls them together.",
              "const lantern = r.hits.findIndex(h => h.doc_id.includes('thrice_bound_lantern'));",
              "const edge = r.hits.findIndex(h => h.doc_id.includes('thrice_bound_edge'));",
              "pm.test('the Lantern plate is retrieved', () => pm.expect(lantern).to.not.eql(-1));",
              "pm.test('the Lantern outranks the Edge', () => {",
              "  if (edge !== -1) pm.expect(lantern).to.be.below(edge);",
              "});"
            ] }
          }]
        },
        {
          "name": "filters - authority_tier does not shrink k",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"query\":\"garrison strength\",\"k\":5,\"filters\":{\"authority_tier\":[1]}}" },
            "url": { "raw": "{{base_url}}/v1/search", "host": ["{{base_url}}"], "path": ["v1", "search"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('k results returned, not fewer', () => pm.expect(r.hits.length).to.eql(5));",
              "pm.test('every hit is tier 1', () => {",
              "  r.hits.forEach(h => pm.expect(h.authority_tier).to.eql(1));",
              "});"
            ] }
          }]
        },
        {
          "name": "ablation - sparse only",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"query\":\"Thrice-Bound Lantern attunement cost\",\"k\":3,\"mode\":\"sparse\",\"rerank\":false}" },
            "url": { "raw": "{{base_url}}/v1/search", "host": ["{{base_url}}"], "path": ["v1", "search"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('mode echoed', () => pm.expect(r.mode).to.eql('sparse'));",
              "pm.test('only the sparse retriever contributed', () => {",
              "  r.hits.forEach(h => pm.expect(h.dense_rank).to.eql(null));",
              "  pm.expect(r.hits[0].sparse_rank).to.eql(1);",
              "});",
              "pm.test('BM25 alone finds the Lantern', () => {",
              "  pm.expect(r.hits[0].doc_id).to.include('thrice_bound_lantern');",
              "});"
            ] }
          }]
        },
        {
          "name": "ablation - dense only",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"query\":\"Thrice-Bound Lantern attunement cost\",\"k\":3,\"mode\":\"dense\",\"rerank\":false}" },
            "url": { "raw": "{{base_url}}/v1/search", "host": ["{{base_url}}"], "path": ["v1", "search"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('only the dense retriever contributed', () => {",
              "  r.hits.forEach(h => pm.expect(h.sparse_rank).to.eql(null));",
              "});"
            ] }
          }]
        },
        {
          "name": "edge case - empty query is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"query\":\"   \"}" },
            "url": { "raw": "{{base_url}}/v1/search", "host": ["{{base_url}}"], "path": ["v1", "search"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('422, not an empty result set', () => pm.response.to.have.status(422));"
            ] }
          }]
        },
        {
          "name": "edge case - 5k character query",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"query\":\"Greyfell Citadel garrison strength recorded in the archive and also \",\"k\":3}" },
            "url": { "raw": "{{base_url}}/v1/search", "host": ["{{base_url}}"], "path": ["v1", "search"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "const long = 'Greyfell Citadel garrison strength '.repeat(160);",
                "pm.request.body.raw = JSON.stringify({ query: long, k: 3 });"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('survives a 5k-char query', () => pm.response.to.have.status(200));",
                "pm.test('still within budget', () => pm.expect(pm.response.json().latency_ms).to.be.below(8000));"
              ] }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Graph",
      "item": [
        {
          "name": "1b_013 - creature to lair to ruler",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"from\":\"Gravemaw Wyrm\",\"to\":\"The Bleeding Crown\",\"max_hops\":3}" },
            "url": { "raw": "{{base_url}}/v1/graph/paths", "host": ["{{base_url}}"], "path": ["v1", "graph", "paths"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('both entities resolved', () => pm.expect(r.resolved).to.be.true);",
              "pm.test('a path exists', () => pm.expect(r.paths.length).to.be.above(0));",
              "pm.test('the hop chain is lair_of then ruled_by', () => {",
              "  const preds = r.paths[0].hops.map(h => h.predicate);",
              "  pm.expect(preds).to.eql(['lair_of', 'ruled_by']);",
              "});",
              "pm.test('every hop cites its evidence', () => {",
              "  r.paths[0].hops.forEach(h => pm.expect(h.evidence_chunk_id).to.be.a('string').and.not.empty);",
              "});",
              "pm.test('the chain is renderable for the answer', () => {",
              "  pm.expect(r.paths[0].readable).to.include('lair_of');",
              "});"
            ] }
          }]
        },
        {
          "name": "1b_003 - bearer to relic to redoubt, with qualifier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"from\":\"Cerys Sablewood the Ashen\",\"to\":\"Gloamreach\",\"max_hops\":3}" },
            "url": { "raw": "{{base_url}}/v1/graph/paths", "host": ["{{base_url}}"], "path": ["v1", "graph", "paths"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('resolved with a path', () => {",
              "  pm.expect(r.resolved).to.be.true;",
              "  pm.expect(r.paths.length).to.be.above(0);",
              "});",
              "// 'since 356 AS' is part of the question, so it must survive into the hop.",
              "pm.test('the since-356-AS qualifier survives', () => {",
              "  const quals = r.paths.flatMap(p => p.hops.map(h => h.qualifier)).filter(Boolean);",
              "  pm.expect(quals.join(' ')).to.include('356');",
              "});"
            ] }
          }]
        },
        {
          "name": "1b_006 - who won the war, and who served in them",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"entity\":\"The War of Drowned Light\",\"hops\":2}" },
            "url": { "raw": "{{base_url}}/v1/graph/neighbors", "host": ["{{base_url}}"], "path": ["v1", "graph", "neighbors"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('resolved', () => pm.expect(r.resolved).to.be.true);",
              "pm.test('the victor is reachable', () => {",
              "  const won = r.edges.filter(e => e.predicate === 'won');",
              "  pm.expect(won.length).to.be.above(0);",
              "});",
              "pm.test('members of the victor are reachable in 2 hops', () => {",
              "  const members = r.edges.filter(e => ['has_member','member_of'].includes(e.predicate));",
              "  pm.expect(members.length).to.be.above(0);",
              "});",
              "pm.test('no unsourced edges leave the API', () => {",
              "  r.edges.forEach(e => pm.expect(e.evidence_chunk_id).to.be.a('string').and.not.empty);",
              "});",
              "pm.test('every edge carries a tier for conflict resolution', () => {",
              "  r.edges.forEach(e => pm.expect(e.authority_tier).to.be.within(1, 5));",
              "});"
            ] }
          }]
        },
        {
          "name": "misspelled entity is refused, not guessed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"entity\":\"Greyfel Citadell\",\"hops\":1}" },
            "url": { "raw": "{{base_url}}/v1/graph/neighbors", "host": ["{{base_url}}"], "path": ["v1", "graph", "neighbors"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('200, not an error', () => pm.response.to.have.status(200));",
              "// Fuzzy-matching invented proper nouns returns a wrong number with a real",
              "// citation. Greyfell Citadel and Ironfell Citadel are different places.",
              "pm.test('says unresolved rather than guessing', () => {",
              "  pm.expect(r.resolved).to.be.false;",
              "  pm.expect(r.entities.length).to.eql(0);",
              "});"
            ] }
          }]
        }
      ]
    },
    {
      "name": "09 Assets",
      "item": [
        {
          "name": "list assets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/assets?limit=5", "host": ["{{base_url}}"], "path": ["v1", "assets"], "query": [{ "key": "limit", "value": "5" }] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('70 unique assets - 85 files deduplicated by content hash', () => {",
              "  pm.expect(r.total).to.eql(70);",
              "});"
            ] }
          }]
        },
        {
          "name": "Emberdeep plate metadata - the planted chart trap",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/assets/{{emberdeep_asset}}/meta", "host": ["{{base_url}}"], "path": ["v1", "assets", "{{emberdeep_asset}}", "meta"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "",
              "// The chart shows 800 / 2,400 / 6,000 as reference standards and 1,114 as",
              "// Emberdeep's own figure - drawn SHORTER than the 6,000 bar. Flat OCR answers",
              "// 6,000; 'longest bar' also answers 6,000. Only label binding gets 1,114.",
              "const byLabel = {};",
              "r.values.forEach(v => byLabel[String(v.label).toLowerCase()] = String(v.value).replace(/,/g, ''));",
              "",
              "pm.test('Emberdeep is bound to 1,114', () => {",
              "  pm.expect(byLabel['emberdeep']).to.eql('1114');",
              "});",
              "pm.test('Emberdeep is NOT bound to the reference values', () => {",
              "  pm.expect(byLabel['emberdeep']).to.not.be.oneOf(['800', '2400', '6000']);",
              "});",
              "pm.test('the reference bars survive as their own labelled entries', () => {",
              "  const values = Object.values(byLabel);",
              "  pm.expect(values).to.include.members(['800', '2400', '6000']);",
              "});",
              "pm.test('linked to its entity for graph traversal', () => {",
              "  pm.expect(r.entity_link).to.eql('ent_emberdeep');",
              "});"
            ] }
          }]
        },
        {
          "name": "fetch the image bytes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/assets/{{greyfell_asset}}", "host": ["{{base_url}}"], "path": ["v1", "assets", "{{greyfell_asset}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('is a PNG', () => pm.expect(pm.response.headers.get('content-type')).to.include('image/png'));",
              "pm.test('non-trivial image', () => pm.expect(pm.response.responseSize).to.be.above(1000));"
            ] }
          }]
        },
        {
          "name": "unknown asset returns 404 with guidance",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/assets/img_doesnotexist/meta", "host": ["{{base_url}}"], "path": ["v1", "assets", "img_doesnotexist", "meta"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('the message names the fix', () => {",
              "  pm.expect(pm.response.json().detail).to.include('src.ingestion.images');",
              "});"
            ] }
          }]
        }
      ]
    }
  ]
}
