       "raw": "{\"query\": \"zzqx wrmbl fthgn plkjhg\", \"k\": 10, \"rerank\": false, \"expand\": true, \"expand_mode\": \"graph\"}"
      },
      "url": {
       "raw": "{{base_url}}/v1/search",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "v1",
        "search"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200 OK', () => pm.response.to.have.status(200));",
         "const r = pm.response.json();",
         "",
         "// Expansion seeds on exact entity matches and there is deliberately no fuzzy",
         "// fallback - a near miss is how greyfell_citadel becomes ironfell_citadel",
         "// (Finding 13). With no seed it must contribute nothing rather than guess.",
         "pm.test('no seed means no expansion', () => pm.expect(r.expanded).to.eql(0));",
         "pm.test('and no invented reasons', () =>",
         "  pm.expect(Object.keys(r.expansion_reasons || {}).length).to.eql(0));"
        ]
       }
      }
     ]
    },
