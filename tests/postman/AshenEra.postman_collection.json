    {
     "name": "graph expansion - reaches the second hop document",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\"query\": \"Which faction won the Purge of Blackport and who are its members\", \"k\": 10, \"rerank\": false, \"expand\": true, \"expand_mode\": \"graph\"}"
      },
      "url": {
       "raw": "{{base_url}}/v1/search",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "v1",
        "search"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200 OK', () => pm.response.to.have.status(200));",
         "const r = pm.response.json();",
         "",
         "// Graph expansion took multi-hop coverage@10 from 0.429 to 0.714 for 20ms,",
         "// while the cross-encoder costs 2.4s and makes the same suite worse.",
         "pm.test('expansion is fast', () => pm.expect(r.latency_ms).to.be.below(2000));",
         "pm.test('returns k hits', () => pm.expect(r.hits.length).to.eql(10));",
         "",
         "// Expansion spends the SAME k (ADR-009). It evicts the weakest base hits",
         "// rather than extending the list, so a coverage gain is a real trade.",
         "pm.test('expansion does not grow the response', () =>",
         "  pm.expect(r.hits.length).to.eql(10));",
         "",
         "pm.test('something was expanded', () => pm.expect(r.expanded).to.be.above(0));",
         "",
         "// A chunk that reached the evidence bundle without a retriever score and",
         "// without an explanation has no business being cited in an answer.",
         "pm.test('every expanded hit explains itself', () => {",
         "  const reasons = r.expansion_reasons || {};",
         "  pm.expect(Object.keys(reasons).length).to.eql(r.expanded);",
         "  Object.values(reasons).forEach(why =>",
         "    pm.expect(why).to.include('reached via'));",
         "});",
         "",
         "// score 0.0 with all three rank fields null is the unambiguous signal that a",
         "// hit arrived by expansion rather than from a retriever.",
         "pm.test('expanded hits are marked as unscored', () => {",
         "  const ids = Object.keys(r.expansion_reasons || {});",
         "  const expanded = r.hits.filter(h => ids.includes(h.chunk_id));",
         "  pm.expect(expanded.length).to.eql(r.expanded);",
         "  expanded.forEach(h => {",
         "    pm.expect(h.score).to.eql(0);",
         "    pm.expect(h.dense_rank).to.eql(null);",
         "    pm.expect(h.sparse_rank).to.eql(null);",
         "    pm.expect(h.text.length).to.be.above(0);",
         "  });",
         "});"
        ]
       }
      }
     ]
    },
