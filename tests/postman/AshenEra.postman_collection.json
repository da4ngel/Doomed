    {
     "name": "Emberdeep plate metadata - the planted chart trap",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/v1/assets/{{emberdeep_asset}}/meta",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "v1",
        "assets",
        "{{emberdeep_asset}}",
        "meta"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('200 OK', () => pm.response.to.have.status(200));",
         "const r = pm.response.json();",
         "",
         "// The chart shows 800 / 2,400 / 6,000 as reference standards and 1,114 as",
         "// Emberdeep's own figure - drawn SHORTER than the 6,000 bar. Flat OCR answers",
         "// 6,000; 'longest bar' also answers 6,000. Only label binding gets 1,114.",
         "const byLabel = {};",
         "r.values.forEach(v => byLabel[String(v.label).toLowerCase()] = String(v.value).replace(/,/g, ''));",
         "",
         "pm.test('Emberdeep is bound to 1,114', () => {",
         "  pm.expect(byLabel['emberdeep']).to.eql('1114');",
         "});",
         "pm.test('Emberdeep is NOT bound to the reference values', () => {",
         "  pm.expect(byLabel['emberdeep']).to.not.be.oneOf(['800', '2400', '6000']);",
         "});",
         "pm.test('the reference bars survive as their own labelled entries', () => {",
         "  const values = Object.values(byLabel);",
         "  pm.expect(values).to.include.members(['800', '2400', '6000']);",
         "});",
         "pm.test('linked to its entity for graph traversal', () => {",
         "  pm.expect(r.entity_link).to.eql('ent_emberdeep');",
         "});"
        ]
       }
      }
     ]
    },
